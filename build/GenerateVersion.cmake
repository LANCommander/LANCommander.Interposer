# Writes version_info.h from the current git tag. Run in script mode on every
# build (see the interposer_version target), so a new tag is picked up without
# reconfiguring:
#
#   cmake -DOUTPUT=<path> [-DVERSION=<tag>] -DSOURCE_DIR=<repo> -P GenerateVersion.cmake
#
# VERSION overrides git (CI passes the pushed tag). Falls back to 0.0.0 when git
# is unavailable or no tag is found. The file is only rewritten when its content
# changes, so an unchanged version does not rebuild every resource file.

set(_tag "${VERSION}")

if(NOT _tag)
    find_package(Git QUIET)
    if(GIT_FOUND)
        execute_process(
            COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" describe --tags --exact-match HEAD
            OUTPUT_VARIABLE _tag OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(NOT _tag)
            execute_process(
                COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" describe --tags --abbrev=0
                OUTPUT_VARIABLE _tag OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        endif()
    endif()
endif()

set(_major 0)
set(_minor 0)
set(_patch 0)
if(_tag MATCHES "^v?([0-9]+)\\.([0-9]+)\\.([0-9]+)")
    set(_major ${CMAKE_MATCH_1})
    set(_minor ${CMAKE_MATCH_2})
    set(_patch ${CMAKE_MATCH_3})
endif()

set(_v "${_major}.${_minor}.${_patch}")
set(_content "#pragma once
// Auto-generated by build/GenerateVersion.cmake - do not edit by hand.
#define VER_MAJOR              ${_major}
#define VER_MINOR              ${_minor}
#define VER_PATCH              ${_patch}
#define VER_BUILD              0
#define VER_FILEVERSION        ${_major},${_minor},${_patch},0
#define VER_PRODUCTVERSION     ${_major},${_minor},${_patch},0
#define VER_FILEVERSION_STR    \"${_v}.0\"
#define VER_PRODUCTVERSION_STR \"${_v}.0\"
#define VER_COMPANY_STR        \"LANCommander\"
#define VER_PRODUCT_STR        \"LANCommander Interposer\"
#define VER_COPYRIGHT_STR      \"Copyright (c) 2024-2026 LANCommander Contributors. MIT License.\"
")

set(_existing "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" _existing)
endif()

if(NOT _content STREQUAL _existing)
    file(WRITE "${OUTPUT}" "${_content}")
    message(STATUS "version_info.h: updated to ${_v}")
endif()
