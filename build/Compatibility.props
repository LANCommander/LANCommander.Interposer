<?xml version="1.0" encoding="utf-8"?>
<!--
  Shared by every project that ships: the hook DLL, the injector and the plugins.
  Import it immediately after Microsoft.Cpp.props.

  Goal: one binary per architecture that loads on every Windows from XP SP3
  (x86) / XP x64 and Server 2003 (x64) up, with no runtime installed. Three
  parts, all load-bearing:

  * Static CRT (/MT). The Visual C++ Redistributable cannot be assumed on a
    game machine, and the 14.x runtime does not install on XP at all. This is
    safe for plugins because the plugin ABI is plain C with caller-owned
    buffers - nothing allocated by one module is freed by another.

  * Subsystem version 5.01 / 5.02. The linker defaults to 6.00, and the XP
    loader rejects such an image outright as "not a valid Win32 application".

  * YY-Thunks. The v143 CRT and STL import Vista+ kernel32 functions directly
    (SRW locks and condition variables behind std::mutex / std::shared_mutex,
    among others), so the image would still fail to load with a missing-entry-
    point error. YY_Thunks_for_WinXP.obj supplies those imports itself: on a
    system that has the real function it forwards to it, on XP it falls back
    to an equivalent. Its entry point additionally gives a LoadLibrary-loaded
    DLL working thread_local on XP, where the loader only allocates implicit
    TLS for modules present at process start - without it the injector and
    ASI load methods would fault on first access.

  Fetch YY-Thunks with build\Get-YYThunks.ps1. Verify a build with
  build\Test-XPImports.ps1, which checks every import against the XP export
  lists that ship with YY-Thunks.
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <YYThunksVersion>1.2.3</YYThunksVersion>
    <YYThunksDir>$(MSBuildThisFileDirectory)YY-Thunks\$(YYThunksVersion)\</YYThunksDir>
    <YYThunksObj Condition="'$(Platform)'=='Win32'">$(YYThunksDir)objs\x86\YY_Thunks_for_WinXP.obj</YYThunksObj>
    <YYThunksObj Condition="'$(Platform)'=='x64'">$(YYThunksDir)objs\x64\YY_Thunks_for_WinXP.obj</YYThunksObj>
    <CompatMinimumSubsystem Condition="'$(Platform)'=='Win32'">5.01</CompatMinimumSubsystem>
    <CompatMinimumSubsystem Condition="'$(Platform)'=='x64'">5.02</CompatMinimumSubsystem>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <RuntimeLibrary Condition="'$(UseDebugLibraries)'=='true'">MultiThreadedDebug</RuntimeLibrary>
      <RuntimeLibrary Condition="'$(UseDebugLibraries)'!='true'">MultiThreaded</RuntimeLibrary>
    </ClCompile>
    <Link>
      <MinimumRequiredVersion>$(CompatMinimumSubsystem)</MinimumRequiredVersion>
      <AdditionalDependencies>$(YYThunksObj);%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>

  <!-- The thread_local fix: YY-Thunks' entry point runs first and then chains to
       the CRT's, which it finds through the alternatename. -->
  <ItemDefinitionGroup Condition="'$(ConfigurationType)'=='DynamicLibrary'">
    <Link>
      <EntryPointSymbol>DllMainCRTStartupForYY_Thunks</EntryPointSymbol>
      <AdditionalOptions Condition="'$(Platform)'=='Win32'">/alternatename:_YY_ThunksOriginalDllMainCRTStartup@12=__DllMainCRTStartup@12 %(AdditionalOptions)</AdditionalOptions>
      <AdditionalOptions Condition="'$(Platform)'=='x64'">/alternatename:YY_ThunksOriginalDllMainCRTStartup=_DllMainCRTStartup %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>

  <Target Name="CompatCheckYYThunks" BeforeTargets="ClCompile;Link">
    <Error Condition="!Exists('$(YYThunksObj)')"
           Text="YY-Thunks $(YYThunksVersion) not found at $(YYThunksObj). Run: powershell -NoProfile -ExecutionPolicy Bypass -File build\Get-YYThunks.ps1" />
  </Target>
</Project>
