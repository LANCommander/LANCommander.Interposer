{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "description": "No generator: CMake picks the newest Visual Studio. The toolset is pinned to v143 to match the vcpkg triplets.",
      "binaryDir": "${sourceDir}/out/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "toolset": { "value": "v143", "strategy": "set" },
      "cacheVariables": {
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/triplets"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "inherits": "windows-base",
      "architecture": { "value": "x64", "strategy": "set" },
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-windows-static" }
    },
    {
      "name": "windows-x86",
      "displayName": "Windows x86",
      "inherits": "windows-base",
      "architecture": { "value": "Win32", "strategy": "set" },
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x86-windows-static" }
    },
    {
      "name": "linux-base",
      "hidden": true,
      "description": "Run inside docker/build.Dockerfile (Debian 12, the LANCommander game server base), so the result runs on its glibc.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/out/${presetName}",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64",
      "inherits": "linux-base",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x64-linux" }
    },
    {
      "name": "linux-x86",
      "displayName": "Linux x86",
      "description": "32-bit, for legacy game servers. Needs gcc-multilib and g++-multilib.",
      "inherits": "linux-base",
      "cacheVariables": { "VCPKG_TARGET_TRIPLET": "x86-linux", "CMAKE_C_FLAGS": "-m32", "CMAKE_CXX_FLAGS": "-m32" }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64-debug",   "configurePreset": "windows-x64", "configuration": "Debug" },
    { "name": "windows-x64-release", "configurePreset": "windows-x64", "configuration": "Release" },
    { "name": "windows-x86-debug",   "configurePreset": "windows-x86", "configuration": "Debug" },
    { "name": "windows-x86-release", "configurePreset": "windows-x86", "configuration": "Release" },
    { "name": "linux-x64-debug",     "configurePreset": "linux-x64",   "configuration": "Debug" },
    { "name": "linux-x64-release",   "configurePreset": "linux-x64",   "configuration": "Release" },
    { "name": "linux-x86-debug",     "configurePreset": "linux-x86",   "configuration": "Debug" },
    { "name": "linux-x86-release",   "configurePreset": "linux-x86",   "configuration": "Release" }
  ]
}
